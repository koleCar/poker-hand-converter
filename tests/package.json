{
  "name": "tests",
  "version": "1.0.0",
  "description": "Vitest harness for the poker hand history converter",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "bench:solver": "vitest run --config scripts/solver-bench/vitest.config.ts",
    "bench:turn": "vitest run --config scripts/solver-bench/vitest.turn.config.ts",
    "charts:generate": "vitest run --config scripts/preflop-charts/vitest.config.ts generate",
    "charts:report": "vitest run --config scripts/preflop-charts/vitest.config.ts report",
    "charts:coverage": "vitest run --config scripts/preflop-charts/vitest.config.ts coverage",
    "charts:compare": "vitest run --config scripts/preflop-charts/vitest.config.ts compare",
    "floplib": "node scripts/flop-library/cli.mjs",
    "charts:library": "vitest run --config scripts/preflop-charts/vitest.config.ts library",
    "floplib:measure": "vitest run --config scripts/flop-library/vitest.config.ts measure",
    "floplib:realisation": "vitest run --config scripts/flop-library/vitest.config.ts flop-library/realisation",
    "floplib:turn-realisation": "vitest run --config scripts/flop-library/vitest.config.ts flop-library/turnRealisation",
    "floplib:multiway-narrowing": "vitest run --config scripts/flop-library/vitest.config.ts multiwayNarrowing",
    "floplib:check-trim": "vitest run --config scripts/flop-library/vitest.config.ts checkTrim.test",
    "floplib:hu-check-trim": "vitest run --config scripts/flop-library/vitest.config.ts headsUpCheckTrim",
    "floplib:river-check-trim": "vitest run --config scripts/flop-library/vitest.config.ts riverCheckTrim",
    "floplib:check-trim-grades":"vitest run --config scripts/flop-library/vitest.config.ts checkTrimGrades",
    "floplib:bets": "vitest run --config scripts/flop-library/vitest.config.ts flopBets",
    "ranges:extract": "vitest run --config scripts/caller-ranges/vitest.config.ts extract",
    "ranges:measure": "vitest run --config scripts/caller-ranges/vitest.config.ts measure",
    "ranges:villain-measure": "vitest run --config scripts/caller-ranges/vitest.config.ts villainMeasure",
    "learn:directions": "vitest run --config scripts/learn-directions/vitest.config.ts directions",
    "learn:lab": "vitest run --config scripts/learn-directions/vitest.config.ts lab",
    "golden:emit": "vitest run --config scripts/golden/vitest.config.ts",
    "desktop-ingest:fixture": "RAIL_PARITY_FIXTURE=1 vitest run --config scripts/desktop-ingest/vitest.config.ts",
    "desktop-ingest:parity": "vitest run --config scripts/desktop-ingest/vitest.config.ts",
    "supabase:perf": "vitest run --config scripts/supabase-perf/vitest.config.ts",
    "realtime:arrivals":"node scripts/realtime-arrivals/check.mjs",
    "phf:dts-check": "tsc -p scripts/phf-dts",
    "wasm:build": "node scripts/wasm/build.mjs",
    "wasm:shadow": "vitest run --config scripts/wasm/vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
