{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,

    /* Linting — unchanged from the Vite config. These are the flags that keep
       the parser layer honest, so they survive the framework move intact. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      /* `@rail/ui` (packages/ui, R2.6) is linked source outside this folder:
         its imports of React resolve to this app's copy, never to whatever is
         (or is not) installed next to the package. Next aliases React the
         same way when it bundles. */
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
