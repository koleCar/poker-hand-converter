{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/h/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Discordbot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|Embedly|Pinterest|SkypeUriPreview|vkShare|Applebot|Iframely|Mastodon|Bluesky|Quora Link Preview|redditbot).*"
        }
      ],
      "destination": "/api/share-meta?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
