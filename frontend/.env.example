# Renamed at the Next.js cutover: Vite inlined `import.meta.env.VITE_*`, Next
# inlines `process.env.NEXT_PUBLIC_*`. The Vercel project settings have to be
# updated in all three environments before the first deploy, or the app ships as
# an offline converter with the library and sharing switched off (which it will
# say plainly, rather than failing silently).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Optional. Set to "off" to hide the "Continue with Google" button.
# Left unset the button is shown, and pressing it before the provider is
# configured in Supabase (Authentication -> Providers) explains that rather
# than failing silently. Email and password need no configuration.
# NEXT_PUBLIC_AUTH_GOOGLE="off"

# Canonical origin. Used for og:url, the sitemap, the clipboard link, and the
# single OAuth redirect address (`${NEXT_PUBLIC_SITE_URL}/auth/callback`, which
# must be in the Supabase redirect allow-list). Leave unset to keep the current
# free *.vercel.app host; set it when a custom domain is live.
NEXT_PUBLIC_SITE_URL=https://poker-hand-converter.vercel.app
