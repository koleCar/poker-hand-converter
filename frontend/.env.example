VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional. Set to "off" to hide the "Continue with Google" button.
# Left unset the button is shown, and pressing it before the provider is
# configured in Supabase (Authentication -> Providers) explains that rather
# than failing silently. Email and password need no configuration.
# VITE_AUTH_GOOGLE="off"

# Canonical origin, used only where there is no browser to ask: the Vercel edge
# function, and every server render after the Next.js move. Leave unset to keep
# the current free *.vercel.app host; set it when a custom domain is live.
VITE_SITE_URL=https://poker-hand-converter.vercel.app
