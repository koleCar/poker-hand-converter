      "players": "any",
      "label": { "en": "VPIP", "hr": "VPIP" },
      "name": { "en": "Voluntarily put money in pot", "hr": "Dobrovoljno uložen novac u pot" },
      "description": {
        "en": "Called, bet or raised preflop of their own accord. Blinds, antes and straddles are not voluntary; a walked big blind has no opportunity.",
        "hr": "Call, bet ili raise preflop svojevoljno. Blindovi, ante i straddle nisu dobrovoljni; big blind kojem svi foldaju nema priliku."
      },
      "formula": "pct(vpip, vpip_opp)",
      "format": { "unit": "percent", "decimals": 1 },
      "sample": { "min": 100 },
      "bands": [
