{
  "$schema": "./stats.schema.json",
  "version": 1,
  "stats": [
    {
      "id": "hands",
      "group": "results",
      "players": "any",
      "label": { "en": "Hands", "hr": "Ruke" },
      "name": { "en": "Hands", "hr": "Ruke" },
      "description": {
        "en": "Hands dealt in the sample (bomb pots left out).",
        "hr": "Podijeljene ruke u uzorku (bomb potovi nisu uključeni)."
      },
      "formula": "hands",
      "format": { "unit": "count", "decimals": 0 },
      "sample": { "of": "hands", "min": 0 },
      "bands": [],
      "hud": "popup"
    },
    {
      "id": "bb_per_100",
      "group": "results",
      "players": "any",
      "label": { "en": "bb/100", "hr": "bb/100" },
      "name": { "en": "Win rate", "hr": "Winrate" },
      "description": {
        "en": "Big blinds won per 100 hands. EV-cashout hands are left out of the money and of the hand count it divides by.",
        "hr": "Big blindovi dobiveni na 100 ruku. Ruke s EV cashoutom nisu ni u novcu ni u broju ruku kojim se dijeli."
      },
      "formula": "net_bb_milli / 1000 / money_hands * 100",
      "format": { "unit": "bb_per_100", "decimals": 2 },
      "sample": { "of": "money_hands", "min": 10000 },
      "bands": [
        { "below": -10, "tone": "very-low" },
        { "below": 0, "tone": "low" },
        { "below": 10, "tone": "normal" },
        { "tone": "high" }
      ],
      "hud": "popup"
    },
    {
      "id": "allin_ev_bb_per_100",
      "group": "results",
      "players": "hero",
      "label": { "en": "EV bb/100", "hr": "EV bb/100" },
      "name": { "en": "All-in EV win rate", "hr": "All-in EV winrate" },
      "description": {
        "en": "Big blinds per 100 hands with the luck of all-in runouts taken out: each all-in with cards to come counts its equity share of the pot instead of the result.",
        "hr": "Big blindovi na 100 ruku bez sreće u all-inima: svaki all-in s kartama koje dolaze broji svoj udio equityja u potu umjesto rezultata."
      },
      "formula": "ev_net_bb_milli / 1000 / money_hands * 100",
      "format": { "unit": "bb_per_100", "decimals": 2 },
      "sample": { "of": "money_hands", "min": 10000 },
      "bands": [
        { "below": -10, "tone": "very-low" },
        { "below": 0, "tone": "low" },
        { "below": 10, "tone": "normal" },
        { "tone": "high" }
      ],
      "hud": "none"
    },
    {
      "id": "net_bb",
      "group": "results",
      "players": "any",
      "label": { "en": "bb", "hr": "bb" },
      "name": { "en": "Result in big blinds", "hr": "Rezultat u big blindovima" },
      "description": {
        "en": "Total result in big blinds, summed across stakes.",
        "hr": "Ukupni rezultat u big blindovima, zbrojen preko svih uloga."
      },
      "formula": "net_bb_milli / 1000",
      "format": { "unit": "bb", "decimals": 1 },
      "sample": { "of": "money_hands", "min": 0 },
      "bands": [],
      "hud": "none"
    },
    {
      "id": "rake_per_100",
      "group": "results",
      "players": "any",
      "label": { "en": "Rake/100", "hr": "Rake/100" },
      "name": { "en": "Rake per 100 hands", "hr": "Rake na 100 ruku" },
      "description": {
        "en": "Fees paid per 100 hands, in the currency's minor units: a pot's rake is borne by the players who collected it. Only meaningful within one currency.",
        "hr": "Plaćene naknade na 100 ruku, u najmanjim jedinicama valute: rake pota plaćaju igrači koji su ga pokupili. Ima smisla samo unutar jedne valute."
      },
      "formula": "rake_paid / money_hands * 100",
      "format": { "unit": "money", "decimals": 2 },
      "sample": { "of": "money_hands", "min": 1000 },
      "bands": [],
      "hud": "none"
    },
    {
      "id": "vpip",
